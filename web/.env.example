# Copy to .env.local (never commit it) and fill in.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application).
# Authorised redirect URI: <APP_URL>/api/auth/callback  (e.g. http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At least 32 random characters. Encrypts the session cookie that holds your Google tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# OpenAI API key for AI features (write with AI, reply drafts, summaries, auto labels). Optional: without it AI is off.
OPENAI_API_KEY=
# Model used for every AI call. Must support Chat Completions structured outputs (json_schema).
OPENAI_MODEL=gpt-5-mini

# Public URL of the app. Optional locally; set it in production so the OAuth redirect URI is exact.
APP_URL=

# Set to 1 to run with a built-in fictional mailbox instead of Google (no credentials needed).
ZL_DEMO=
